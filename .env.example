# Copy to .env (backend) or frontend/.env.local (frontend). Never commit real values.

# Backend
TYPESAFE_API_KEY=            # Jev; leave empty to use the mock classifier
JEV_MODEL=jev-1.13.0
ANTHROPIC_API_KEY=           # country briefings and scenario parsing
GDELT_POLL_MINUTES=15
TRACE_ARCHIVE_PATH=data_collection/work/trace.sqlite   # canonical SQLite archive (python3 data_collection/manage.py download)
TRACE_DB_PATH=backend/data/derived.sqlite            # derived model tables (edges, predictions, risk)
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=         # empty = use contracts/fixtures
